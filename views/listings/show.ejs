<% layout("/layouts/boilerplate") -%>

<div class="row mt-3">
<div class="col-8 offset-2">
<body>
    <h2><%=listing.title %></h2>
  </div>  
    <div class="card listing-card col-6 offset-2">
        <img src="<%=listing.image %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
          <p class="card-text">
             Owned By:<b><%=listing.owner.username%></b><br>
             <%=listing.description %><br>
             &#8377;<%=listing.price.toLocaleString("en-IN") %><br>
             <%=listing.location %><br>
             <%=listing.country %><br>
          </p>
        </div>
    </div>


    <% if(currUser && currUser._id.equals(listing.owner._id)){ %>
    <div class="btns mb-3 offset-2">
        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark edit-btn">Edit</a>

        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
           <button class="btn btn-dark delete-btn">Delete</button>
        </form>
    </div>
    <%  } %>


    <div class="col-8 offset-2">
      <% if(currUser){ %>
      <hr/>  
      <h4>Leave a Review</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
          <div class="mt-3">
             <label for="rating" class="form-label">Rating</label>
             <!-- <input type="range" min="1" max="5" name="review[rating]" id="rating"> -->
            <fieldset class="starability-slot">
             <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
             <input type="radio" id="first-rate1" name="review[rating]" value="1" />
             <label for="first-rate1" title="Terrible">1 star</label>
             <input type="radio" id="first-rate2" name="review[rating]" value="2" />
             <label for="first-rate2" title="Not good">2 stars</label>
             <input type="radio" id="first-rate3" name="review[rating]" value="3" />
             <label for="first-rate3" title="Average">3 stars</label>
             <input type="radio" id="first-rate4" name="review[rating]" value="4" />
             <label for="first-rate4" title="Very good">4 stars</label>
             <input type="radio" id="first-rate5" name="review[rating]" value="5" />
             <label for="first-rate5" title="Amazing">5 stars</label>
           </fieldset>
          </div>

          <div class="mt-3">
             <label for="comment" class="form-label">Comment</label>
             <textarea rows="5" cols="30" name="review[comment]" required class="form-control" id="comment"></textarea>
             <div class="invalid-feedback">Please enter a comment</div>
          </div>

          <button class="btn btn-dark mt-3 mb-3" >Submit</button>
        </form>
      <% } %>  
    </div>

    <div class="col-8 offset-2 mt-3 mb-3">
      <hr>
      <h4>All Reviews</h4>

      <div class="row review-container">
       <ul>
        <% for(review of listing.reviews){ %>
          <% if (review) { %>  <!-- Avoid null reviews -->
           <div class="card col-6 ms-3 mb-3">
              <div class="card-body review-card-body">
                <div class="card-title"><b>@<%=review.author.username%></b></div>
                <p class="starability-result card-text" data-rating="<%=review.rating%>"></p>
                <p class="card-text"><%=review.comment%></p>
              </div>
              <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                <% console.log( listing._id ) %>
                <% console.log( review._id )  %>
                <button class="btn btn-sm btn-dark mb-2 review-btn">Delete</button>
              </form>
           </div>
          <% } %>
        <% } %>
       </ul>  
      </div>
    </div>

</body>
  
</div>  
